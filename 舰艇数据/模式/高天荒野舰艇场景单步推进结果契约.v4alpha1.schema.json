{
  "$id": "gaotian.tactical-scene-step-resolution/v4alpha1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "ammunition_cookoff_events": {
      "items": {
        "type": "object"
      },
      "type": "array"
    },
    "continuous_damage_events": {
      "items": {
        "type": "object"
      },
      "type": "array"
    },
    "crew_casualty_events": {
      "items": {
        "type": "object"
      },
      "type": "array"
    },
    "crew_evacuation_events": {
      "items": {
        "type": "object"
      },
      "type": "array"
    },
    "crew_rescue_manifests": {
      "items": {
        "type": "object"
      },
      "type": "array"
    },
    "engagement_events": {
      "items": {
        "type": "object"
      },
      "type": "array"
    },
    "expired_events": {
      "items": {
        "type": "object"
      },
      "type": "array"
    },
    "fire_control_support_events": {
      "items": {
        "type": "object"
      },
      "type": "array"
    },
    "fire_propagation_events": {
      "items": {
        "type": "object"
      },
      "type": "array"
    },
    "generated_guidance_fact_events": {
      "items": {
        "type": "object"
      },
      "type": "array"
    },
    "guidance_events": {
      "items": {
        "type": "object"
      },
      "type": "array"
    },
    "impact_events": {
      "items": {
        "type": "object"
      },
      "type": "array"
    },
    "interface": {
      "const": "gaotian.tactical-scene-step-resolution/v4alpha1"
    },
    "lifecycle_events": {
      "items": {
        "type": "object"
      },
      "type": "array"
    },
    "policy": {
      "const": "gaotian.tactical-scene-step/actual-open-integrate-close-unprotected/v1"
    },
    "propulsion_events": {
      "items": {
        "$ref": "gaotian.tactical-scene-propulsion-event/v2alpha1"
      },
      "type": "array"
    },
    "radar_emission_events": {
      "items": {
        "type": "object"
      },
      "type": "array"
    },
    "resulting_scene_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "sensor_observation_events": {
      "items": {
        "type": "object"
      },
      "type": "array"
    },
    "ship_results": {
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "ship_id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]*$"
          },
          "resulting_runtime_parameters_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "diagnostics": {
            "oneOf": [
              {
                "$ref": "gaotian.actual-propulsion-step-diagnostics/v1alpha1"
              },
              {
                "type": "null"
              }
            ]
          },
          "propulsion_aggregation": {
            "$ref": "gaotian.actual-propulsion-aggregation/v1alpha1"
          },
          "propulsion_delivery_status": {
            "enum": [
              "delivered",
              "suppressed_falling",
              "suppressed_exited",
              "suppressed_uncommanded"
            ]
          },
          "missing_propulsion_channels": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "enum": [
                "translation.forward",
                "translation.reverse",
                "translation.left",
                "translation.right",
                "yaw.counterclockwise",
                "yaw.clockwise"
              ]
            }
          }
        },
        "required": [
          "ship_id",
          "resulting_runtime_parameters_sha256",
          "diagnostics",
          "propulsion_aggregation",
          "propulsion_delivery_status",
          "missing_propulsion_channels"
        ]
      },
      "type": "array"
    },
    "source_scene_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "spawned_projectiles": {
      "items": {
        "type": "object"
      },
      "type": "array"
    },
    "weapon_events": {
      "items": {
        "type": "object"
      },
      "type": "array"
    },
    "source_fixed_step_index": {
      "type": "integer",
      "minimum": 0
    },
    "resulting_fixed_step_index": {
      "type": "integer",
      "minimum": 1
    },
    "propulsion_boundaries": {
      "type": "array",
      "items": {
        "$ref": "gaotian.actual-propulsion-boundary/v1alpha1"
      }
    },
    "soft_governor_status": {
      "const": "unwired"
    },
    "hard_fault_status": {
      "const": "unwired"
    },
    "direction_interlock_status": {
      "const": "unwired"
    }
  },
  "required": [
    "engagement_events",
    "expired_events",
    "impact_events",
    "interface",
    "lifecycle_events",
    "policy",
    "propulsion_events",
    "resulting_scene_sha256",
    "ship_results",
    "source_scene_sha256",
    "spawned_projectiles",
    "weapon_events",
    "source_fixed_step_index",
    "resulting_fixed_step_index",
    "propulsion_boundaries",
    "soft_governor_status",
    "hard_fault_status",
    "direction_interlock_status"
  ],
  "type": "object",
  "description": "实际固定步结果，原有武器/命中等事件保持既有形状。完整源场景、结果对象和精确资源上下文用于重新验证记录链；不升级或放宽旧 v3 结果。"
}
