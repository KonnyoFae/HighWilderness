          "type": "string"
        },
        "exhaust_clearance_half_cells": {
          "items": {
            "$ref": "#/$defs/halfCellPoint"
          },
          "type": "array",
          "uniqueItems": true
        },
        "host_slot": {
          "oneOf": [
            {
              "$ref": "#/$defs/resourceId"
            },
            {
              "type": "null"
            }
          ]
        },
        "internal_deck_span": {
          "minimum": 0,
          "type": "integer"
        },
        "internal_footprint_half_cells": {
          "items": {
            "$ref": "#/$defs/halfCellPoint"
          },
          "type": "array",
          "uniqueItems": true
        },
        "provided_slots": {
          "items": {
            "$ref": "#/$defs/resourceId"
          },
          "type": "array",
          "uniqueItems": true
        },
        "side_clearance_half_cells": {
          "items": {
            "$ref": "#/$defs/halfCellPoint"
          },
          "type": "array",
          "uniqueItems": true
        },
        "side_external_footprint_half_cells": {
          "items": {
            "$ref": "#/$defs/halfCellPoint"
          },
          "type": "array",
          "uniqueItems": true
        },
        "side_mount_length_steps": {
          "minimum": 0,
          "type": "integer"
        },
        "top_clearance_half_cells": {
          "items": {
            "$ref": "#/$defs/halfCellPoint"
          },
          "type": "array",
          "uniqueItems": true
        },
        "top_deck_offset": {
          "minimum": 0,
          "type": "integer"
        },
        "top_footprint_half_cells": {
          "items": {
            "$ref": "#/$defs/halfCellPoint"
          },
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "internal_footprint_half_cells",
        "internal_deck_span",
        "top_footprint_half_cells",
        "top_deck_offset",
        "top_clearance_half_cells",
        "side_mount_length_steps",
        "side_external_footprint_half_cells",
        "side_clearance_half_cells",
        "exhaust_clearance_half_cells",
        "host_slot",
        "provided_slots",
        "allowed_rotations_deg",
        "deck_rule"
      ],
      "type": "object"
    },
