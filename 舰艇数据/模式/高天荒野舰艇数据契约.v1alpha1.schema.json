        }
      },
      "required": [
        "generation_kw",
        "standby_load_kw",
        "active_load_kw",
        "consumer_category"
      ],
      "type": "object"
    },
    "modulePrototype": {
      "additionalProperties": false,
      "properties": {
        "automatic_activation_events": {
          "items": {
            "$ref": "#/$defs/resourceId"
          },
          "type": "array",
          "uniqueItems": true
        },
        "automation": {
          "$ref": "#/$defs/moduleAutomation"
        },
        "balance_status": {
