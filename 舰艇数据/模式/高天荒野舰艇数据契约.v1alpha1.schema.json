          },
          "required": [
            "kind",
            "team_capacity",
            "simultaneous_incidents"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "capacities": {
              "items": {
                "$ref": "#/$defs/moduleCrewCapacity"
              },
              "minItems": 1,
              "type": "array"
            },
            "kind": {
              "const": "crew_quarters"
            }
          },
          "required": [
            "kind",
            "capacities"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "bulk_cargo_capacity_kg": {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            "kind": {
              "const": "cargo_hold"
            }
          },
          "required": [
            "kind",
            "bulk_cargo_capacity_kg"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "remote_core"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "compatible_munition_ids": {
              "items": {
                "$ref": "#/$defs/resourceId"
              },
              "minItems": 1,
              "type": "array",
              "uniqueItems": true
            },
            "engagement_domains": {
              "items": {
                "enum": [
                  "aircraft",
                  "fixed_installation",
                  "missile",
                  "ship"
                ]
              },
              "minItems": 1,
              "type": "array",
              "uniqueItems": true
            },
            "fire_control_requirement": {
              "enum": [
                "none",
                "solution",
                "continuous_guidance"
              ]
            },
            "kind": {
              "const": "weapon"
            },
            "maximum_range_m": {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            "minimum_range_m": {
              "minimum": 0,
              "type": "number"
            },
            "ready_round_capacity": {
              "minimum": 1,
              "type": "integer"
            },
            "weapon_class": {
              "enum": [
                "active_defense",
                "gun",
                "missile_launcher"
              ]
            }
          },
          "required": [
            "kind",
            "weapon_class",
            "engagement_domains",
            "compatible_munition_ids",
            "ready_round_capacity",
            "minimum_range_m",
            "maximum_range_m",
            "fire_control_requirement"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "capacity_units": {
              "minimum": 1,
              "type": "integer"
            },
            "compatible_munition_ids": {
              "items": {
                "$ref": "#/$defs/resourceId"
              },
              "minItems": 1,
              "type": "array",
              "uniqueItems": true
            },
            "inventory_scope": {
              "const": "ship_shared"
            },
            "kind": {
              "const": "ammunition_magazine"
            }
          },
          "required": [
            "kind",
            "capacity_units",
            "compatible_munition_ids",
            "inventory_scope"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "fire_control"
            },
            "maximum_lock_range_m": {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            "simultaneous_channels": {
              "minimum": 1,
              "type": "integer"
            },
            "supported_requirements": {
              "items": {
                "enum": [
                  "solution",
                  "continuous_guidance"
                ]
              },
              "minItems": 1,
              "type": "array",
              "uniqueItems": true
            }
          },
          "required": [
            "kind",
            "supported_requirements",
            "simultaneous_channels",
            "maximum_lock_range_m"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "sensor"
            },
            "maximum_instrumented_range_m": {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            "sensor_channel": {
              "enum": [
                "infrared",
                "optical",
                "radar"
              ]
            },
            "supported_modes": {
              "items": {
                "enum": [
                  "active_search",
                  "fire_control_lock",
                  "passive_search",
                  "track"
                ]
              },
              "minItems": 1,
              "type": "array",
              "uniqueItems": true
            }
          },
          "required": [
            "kind",
            "sensor_channel",
            "supported_modes",
            "maximum_instrumented_range_m"
          ],
          "type": "object"
        }
      ]
    },
    "moduleCrewCapacity": {
      "additionalProperties": false,
      "properties": {
        "capacity": {
          "minimum": 1,
          "type": "integer"
        },
        "crew_type": {
          "$ref": "#/$defs/moduleCrewType"
        }
      },
      "required": [
        "crew_type",
        "capacity"
      ],
      "type": "object"
    },
    "moduleCrewRequirement": {
      "additionalProperties": false,
      "properties": {
        "crew_type": {
          "$ref": "#/$defs/moduleCrewType"
        },
        "minimum_operating": {
          "minimum": 0,
          "type": "integer"
        },
        "standard": {
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "crew_type",
        "minimum_operating",
        "standard"
      ],
      "type": "object"
    },
    "moduleCrewType": {
      "enum": [
        "officer",
        "technical_officer",
        "pilot",
        "veteran_damage_control",
        "ordinary"
      ],
      "type": "string"
    },
    "moduleInstallation": {
      "additionalProperties": false,
      "properties": {
        "allowed_rotations_deg": {
          "items": {
            "enum": [
              0,
              90,
              180,
              270
            ],
            "type": "integer"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "deck_rule": {
          "enum": [
            "any",
            "base_only",
            "local_exposed_top"
