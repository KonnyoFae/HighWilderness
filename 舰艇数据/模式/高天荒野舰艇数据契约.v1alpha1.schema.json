          "maximum": 1,
          "minimum": 0,
          "type": "number"
        }
      },
      "required": [
        "durability_fraction",
        "output_fraction"
      ],
      "type": "object"
    },
    "moduleFunctionDamageResponse": {
      "additionalProperties": false,
