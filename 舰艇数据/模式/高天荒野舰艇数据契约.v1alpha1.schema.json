{
  "$id": "https://gaotianwilderness.invalid/schema/ship/v1alpha1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "$ref": "#/$defs/materialCatalog"
    },
    {
      "$ref": "#/$defs/hullBlueprint"
    },
    {
      "$ref": "#/$defs/hullCoatingCatalog"
    },
    {
      "$ref": "#/$defs/modulePrototypeCatalog"
    },
    {
      "$ref": "#/$defs/outfitPlan"
    },
    {
      "$ref": "#/$defs/sortieConfiguration"
    },
    {
      "$ref": "#/$defs/shipInstanceSnapshot"
    }
  ],
  "title": "高天荒野舰艇数据契约 v1alpha1",
  "$defs": {
    "baseArmorMaterial": {
      "additionalProperties": false,
      "properties": {
        "cost_coefficient": {
          "exclusiveMinimum": 0,
          "type": "number"
        },
        "density_kg_m3": {
          "exclusiveMinimum": 0,
          "type": "number"
        },
        "id": {
          "$ref": "#/$defs/resourceId"
        },
        "local_durability_coefficient": {
          "minimum": 0,
          "type": "number"
        },
        "name": {
          "minLength": 1,
          "type": "string"
        },
        "protection_coefficient": {
          "minimum": 0,
          "type": "number"
        },
        "shell_strength_coefficient": {
          "minimum": 0,
          "type": "number"
        },
        "version": {
          "$ref": "#/$defs/version"
        },
        "work_difficulty": {
          "exclusiveMinimum": 0,
          "type": "number"
        }
      },
      "required": [
        "id",
        "version",
        "name",
        "density_kg_m3",
        "protection_coefficient",
        "local_durability_coefficient",
        "shell_strength_coefficient",
        "cost_coefficient",
        "work_difficulty"
      ],
      "type": "object"
    },
    "deck": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/resourceId"
        },
        "is_base": {
          "type": "boolean"
        },
        "level": {
          "minimum": 0,
          "type": "integer"
        },
        "regions": {
          "items": {
            "$ref": "#/$defs/region"
          },
          "minItems": 1,
          "type": "array"
        },
        "structure_material": {
          "$ref": "#/$defs/resourceReference"
        }
      },
      "required": [
        "id",
        "level",
        "is_base",
        "structure_material",
        "regions"
      ],
      "type": "object"
    },
    "edgeArmor": {
      "additionalProperties": false,
      "properties": {
        "material": {
          "$ref": "#/$defs/resourceReference"
        },
        "thickness_m": {
          "minimum": 0,
          "type": "number"
        }
      },
      "required": [
        "material",
        "thickness_m"
      ],
      "type": "object"
    },
    "grid": {
      "additionalProperties": false,
      "properties": {
        "cell_size_m": {
          "const": 5.0
        },
        "cic_origin_cell": {
          "const": [
            0,
            0
          ]
        },
        "deck_height_m": {
          "const": 5.0
        },
        "forward_axis": {
          "const": "+Y"
        },
        "symmetry_axis": {
          "const": "Y"
        }
      },
      "required": [
        "cell_size_m",
        "deck_height_m",
        "forward_axis",
        "symmetry_axis",
        "cic_origin_cell"
      ],
      "type": "object"
    },
    "hullBlueprint": {
      "additionalProperties": false,
      "properties": {
        "decks": {
          "items": {
            "$ref": "#/$defs/deck"
          },
          "minItems": 1,
          "type": "array"
        },
        "fixture_level": {
          "enum": [
            "canonical_blueprint_fixture",
            "balance_reference"
          ],
          "type": "string"
        },
        "grid": {
          "$ref": "#/$defs/grid"
        },
        "id": {
          "$ref": "#/$defs/resourceId"
        },
        "kind": {
          "const": "HullBlueprint"
        },
        "name": {
          "minLength": 1,
          "type": "string"
        },
        "schema": {
          "const": "gaotian.ship/v1alpha1"
        },
        "version": {
          "$ref": "#/$defs/version"
        }
      },
      "required": [
        "schema",
        "kind",
        "id",
        "version",
        "name",
        "fixture_level",
        "grid",
        "decks"
      ],
      "type": "object"
    },
    "hullCoating": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "runtime_usable": {
                "const": true
              }
            }
          },
          "then": {
            "properties": {
              "rcs_multiplier": {
                "exclusiveMinimum": 0,
                "type": "number"
              }
            }
          },
          "else": {
            "properties": {
              "rcs_multiplier": {
                "type": "null"
              }
            }
          }
        }
      ],
      "properties": {
        "balance_status": {
          "enum": [
            "baseline_locked",
            "awaiting_joint_calibration"
          ],
          "type": "string"
        },
        "default_for_new_build": {
          "type": "boolean"
        },
        "id": {
          "$ref": "#/$defs/resourceId"
        },
        "name": {
          "minLength": 1,
          "type": "string"
        },
        "rcs_multiplier": {
          "type": [
            "number",
            "null"
          ]
        },
        "runtime_usable": {
          "type": "boolean"
        },
        "version": {
          "$ref": "#/$defs/version"
        }
      },
      "required": [
        "id",
        "version",
        "name",
        "balance_status",
        "rcs_multiplier",
        "runtime_usable",
        "default_for_new_build"
      ],
      "type": "object"
    },
    "hullCoatingCatalog": {
      "additionalProperties": false,
      "properties": {
        "coatings": {
          "items": {
            "$ref": "#/$defs/hullCoating"
          },
          "minItems": 1,
          "type": "array"
        },
        "id": {
          "$ref": "#/$defs/resourceId"
        },
        "kind": {
          "const": "HullCoatingCatalog"
        },
        "name": {
          "minLength": 1,
          "type": "string"
        },
        "schema": {
          "const": "gaotian.ship/v1alpha1"
        },
        "version": {
          "$ref": "#/$defs/version"
        }
      },
      "required": [
        "schema",
        "kind",
        "id",
        "version",
        "name",
        "coatings"
      ],
      "type": "object"
    },
    "materialCatalog": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "catalog_type": {
                "const": "structure"
              }
            }
          },
          "then": {
            "properties": {
              "materials": {
                "items": {
                  "$ref": "#/$defs/structureMaterial"
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "catalog_type": {
                "const": "base_armor"
              }
            }
          },
          "then": {
            "properties": {
              "materials": {
                "items": {
                  "$ref": "#/$defs/baseArmorMaterial"
                }
              }
            }
          }
        }
      ],
      "properties": {
        "catalog_type": {
          "enum": [
            "structure",
            "base_armor"
          ],
          "type": "string"
        },
        "id": {
          "$ref": "#/$defs/resourceId"
        },
        "kind": {
          "const": "MaterialCatalog"
        },
        "materials": {
          "minItems": 1,
          "type": "array"
        },
        "name": {
          "minLength": 1,
          "type": "string"
        },
        "schema": {
          "const": "gaotian.ship/v1alpha1"
        },
        "version": {
          "$ref": "#/$defs/version"
        }
      },
      "required": [
        "schema",
        "kind",
        "id",
        "version",
        "name",
        "catalog_type",
        "materials"
      ],
      "type": "object"
    },
    "halfCellPoint": {
      "items": false,
      "maxItems": 2,
      "minItems": 2,
      "prefixItems": [
        {
          "type": "integer"
        },
        {
          "type": "integer"
        }
      ],
      "type": "array"
    },
    "moduleAutomation": {
      "additionalProperties": false,
      "properties": {
        "automated_functions": {
          "items": {
            "$ref": "#/$defs/resourceId"
          },
          "type": "array",
          "uniqueItems": true
        },
        "engineering_microclusters_required": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "level": {
          "enum": [
            "manual",
            "partial",
            "full"
          ],
          "type": "string"
        },
        "unmanned_variant": {
          "oneOf": [
            {
              "$ref": "#/$defs/resourceReference"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "level",
        "automated_functions",
        "unmanned_variant",
        "engineering_microclusters_required"
      ],
      "type": "object"
    },
    "moduleCapability": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "fixed_to_cic_origin": {
              "const": true
            },
            "kind": {
              "const": "cic"
            }
          },
          "required": [
            "kind",
            "fixed_to_cic_origin"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "fuel_capacity_units": {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            "kind": {
              "const": "lift_fuel_tank"
            },
            "lift_force_n": {
              "exclusiveMinimum": 0,
              "type": "number"
            }
          },
          "required": [
            "kind",
            "lift_force_n",
            "fuel_capacity_units"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "fuel_units_per_s": {
              "minimum": 0,
              "type": "number"
            },
            "kind": {
              "enum": [
                "main_engine",
                "maneuver_thruster"
              ]
            },
            "local_thrust_axis": {
              "const": "+Y"
            },
            "response_time_s": {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            "thrust_n": {
              "exclusiveMinimum": 0,
              "type": "number"
            }
          },
          "required": [
            "kind",
            "thrust_n",
            "fuel_units_per_s",
            "response_time_s",
            "local_thrust_axis"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "generator"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "damage_control"
            },
            "simultaneous_incidents": {
              "minimum": 1,
              "type": "integer"
