{
  "$id": "gaotian.fully-governed-propulsion-opening/v1alpha1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "direction_interlock": {
      "$ref": "gaotian.governed-propulsion-direction-interlock/v1alpha1"
    },
    "fixed_step_index": {
      "minimum": 0,
      "type": "integer"
    },
    "hard_fault_opening": {
      "$ref": "gaotian.governed-propulsion-hard-fault-opening/v1alpha1"
    },
    "interface": {
      "const": "gaotian.fully-governed-propulsion-opening/v1alpha1"
    },
    "policy": {
      "const": "gaotian.governed-propulsion/hard-interlock-time-delivery-soft/v1"
    },
    "requested_control": {
      "$ref": "gaotian.tactical-propulsion-control/v2alpha1"
    },
    "resulting_state_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "source_control": {
      "$ref": "gaotian.tactical-propulsion-control/v2alpha1"
    },
    "source_state_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "state": {
      "$ref": "gaotian.tactical-propulsion-state/v3alpha1"
    },
    "time_results": {
      "items": {
        "$ref": "gaotian.governed-propulsion-time-result/v1alpha1"
      },
      "minItems": 1,
      "type": "array"
    }
  },
  "required": [
    "direction_interlock",
    "fixed_step_index",
    "hard_fault_opening",
    "interface",
    "policy",
    "requested_control",
    "resulting_state_sha256",
    "source_control",
    "source_state_sha256",
    "state",
    "time_results"
  ],
  "type": "object"
}
