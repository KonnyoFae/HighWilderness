{
  "$id": "gaotian.actual-propulsion-step-diagnostics/v2alpha1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "受控实际推进积分诊断；绑定本步源推进状态与六通道 governor 指纹。硬故障与方向互锁仍未接线。",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "request": {"$ref": "gaotian.actual-propulsion-step-diagnostics/v1alpha1#/properties/request"},
    "resulting_fixed_step_index": {"$ref": "gaotian.actual-propulsion-step-diagnostics/v1alpha1#/properties/resulting_fixed_step_index"},
    "requested_fuel_units": {"$ref": "gaotian.actual-propulsion-step-diagnostics/v1alpha1#/properties/requested_fuel_units"},
    "fuel_delivery_fraction": {"$ref": "gaotian.actual-propulsion-step-diagnostics/v1alpha1#/properties/fuel_delivery_fraction"},
    "structure_ratio": {"$ref": "gaotian.actual-propulsion-step-diagnostics/v1alpha1#/properties/structure_ratio"},
    "crew_g": {"$ref": "gaotian.actual-propulsion-step-diagnostics/v1alpha1#/properties/crew_g"},
    "hull_integrity_damage": {"$ref": "gaotian.actual-propulsion-step-diagnostics/v1alpha1#/properties/hull_integrity_damage"},
    "fuel_units_consumed": {"$ref": "gaotian.actual-propulsion-step-diagnostics/v1alpha1#/properties/fuel_units_consumed"},
    "active_force_body_n": {"$ref": "gaotian.actual-propulsion-step-diagnostics/v1alpha1#/properties/active_force_body_n"},
    "active_torque_n_m": {"$ref": "gaotian.actual-propulsion-step-diagnostics/v1alpha1#/properties/active_torque_n_m"},
    "drag_force_world_n": {"$ref": "gaotian.actual-propulsion-step-diagnostics/v1alpha1#/properties/drag_force_world_n"},
    "drag_breakdown": {"$ref": "gaotian.actual-propulsion-step-diagnostics/v1alpha1#/properties/drag_breakdown"},
    "source_propulsion_state_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_governors_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "interface": {"const": "gaotian.actual-propulsion-step-diagnostics/v2alpha1"},
    "policy": {"const": "gaotian.tactical-dynamics/governed-source-actual-output/v1"},
    "soft_governor_status": {"const": "wired"},
    "hard_fault_status": {"const": "unwired"},
    "direction_interlock_status": {"const": "unwired"}
  },
  "required": [
    "request",
    "resulting_fixed_step_index",
    "requested_fuel_units",
    "fuel_delivery_fraction",
    "structure_ratio",
    "crew_g",
    "hull_integrity_damage",
    "fuel_units_consumed",
    "active_force_body_n",
    "active_torque_n_m",
    "drag_force_world_n",
    "drag_breakdown",
    "source_propulsion_state_sha256",
    "source_governors_sha256",
    "interface",
    "policy",
    "soft_governor_status",
    "hard_fault_status",
    "direction_interlock_status"
  ]
}
