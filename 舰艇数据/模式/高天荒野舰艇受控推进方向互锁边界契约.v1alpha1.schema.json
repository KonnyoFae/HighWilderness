{
  "$id": "gaotian.governed-propulsion-direction-interlock/v1alpha1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "decisions": {
      "items": {
        "$ref": "gaotian.propulsion-direction-interlock-decision/v1alpha1"
      },
      "maxItems": 6,
      "minItems": 6,
      "type": "array"
    },
    "effective_control": {
      "$ref": "gaotian.tactical-propulsion-control/v2alpha1"
    },
    "effective_control_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "fixed_step_index": {
      "minimum": 0,
      "type": "integer"
    },
    "interface": {
      "const": "gaotian.governed-propulsion-direction-interlock/v1alpha1"
    },
    "policy": {
      "const": "gaotian.propulsion-direction-interlock/opposed-zero-before-increase/v1"
    },
    "propulsion_state_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "requested_control": {
      "$ref": "gaotian.tactical-propulsion-control/v2alpha1"
    },
    "requested_control_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "source_hard_fault_opening_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    }
  },
  "required": [
    "decisions",
    "effective_control",
    "effective_control_sha256",
    "fixed_step_index",
    "interface",
    "policy",
    "propulsion_state_sha256",
    "requested_control",
    "requested_control_sha256",
    "source_hard_fault_opening_sha256"
  ],
  "type": "object"
}
