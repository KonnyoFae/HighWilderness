{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gaotianwilderness.invalid/schema/hull/v4alpha1",
  "title": "逐层结构与逐边外飘装甲合同 v4alpha1",
  "$ref": "#/$defs/hullBlueprint",
  "$defs": {
    "hullBlueprint": {
      "additionalProperties": false,
      "properties": {
        "decks": {
          "items": {
            "$ref": "#/$defs/deck"
          },
          "minItems": 1,
          "type": "array"
        },
        "fixture_level": {
          "enum": [
            "canonical_blueprint_fixture",
            "balance_reference"
          ],
          "type": "string"
        },
        "grid": {
          "$ref": "#/$defs/grid"
        },
        "id": {
          "$ref": "#/$defs/resourceId"
        },
        "kind": {
          "const": "HullBlueprint"
        },
        "name": {
          "minLength": 1,
          "type": "string"
        },
        "schema": {
          "const": "gaotian.hull/v4alpha1"
        },
        "version": {
          "$ref": "#/$defs/version"
        }
      },
      "required": [
        "schema",
        "kind",
        "id",
        "version",
        "name",
        "fixture_level",
        "grid",
        "decks"
      ],
      "type": "object"
    },
    "deck": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/resourceId"
        },
        "is_base": {
          "type": "boolean"
        },
        "level": {
          "minimum": 0,
          "type": "integer"
        },
        "regions": {
          "items": {
            "$ref": "#/$defs/region"
          },
          "minItems": 1,
          "type": "array"
        },
        "structure_material": {
          "$ref": "#/$defs/resourceReference"
        },
        "filling": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "version"
          ],
          "properties": {
            "id": {
              "enum": [
                "gtw.filling.none",
                "gtw.filling.rack",
                "gtw.filling.spirit_fuel",
                "gtw.filling.fireproof"
              ]
            },
            "version": {
              "const": 1
            }
          }
        },
        "structure_thickness_m": {
          "type": "number",
          "enum": [
            0.015,
            0.02,
            0.025,
            0.03,
            0.035,
            0.04,
            0.045,
            0.05,
            0.055,
            0.06,
            0.065,
            0.07,
            0.075,
            0.08,
            0.085,
            0.09,
            0.095,
            0.1
          ]
        }
      },
      "required": [
        "id",
        "level",
        "is_base",
        "structure_material",
        "regions",
        "filling",
        "structure_thickness_m"
      ],
      "type": "object"
    },
    "resourceId": {
      "pattern": "^[a-z0-9][a-z0-9._-]*$",
      "type": "string"
    },
    "region": {
      "additionalProperties": false,
      "properties": {
        "edge_armor": {
          "items": {
            "$ref": "#/$defs/edgeArmor"
          },
          "minItems": 3,
          "type": "array"
        },
        "id": {
          "$ref": "#/$defs/resourceId"
        },
        "vertices_m": {
          "items": {
            "$ref": "#/$defs/pointMeters"
          },
          "minItems": 3,
          "type": "array"
        }
      },
      "required": [
        "id",
        "vertices_m",
        "edge_armor"
      ],
      "type": "object"
    },
    "edgeArmor": {
      "additionalProperties": false,
      "properties": {
        "material": {
          "$ref": "#/$defs/resourceReference"
        },
        "thickness_m": {
          "minimum": 0,
          "type": "number"
        },
        "flare_angle_deg": {
          "type": "integer",
          "enum": [
            0,
            30,
            45,
            60
          ]
        }
      },
      "required": [
        "material",
        "thickness_m",
        "flare_angle_deg"
      ],
      "type": "object",
      "allOf": [
        {
          "if": {
            "properties": {
              "flare_angle_deg": {
                "enum": [
                  30,
                  45,
                  60
                ]
              }
            }
          },
          "then": {
            "properties": {
              "thickness_m": {
                "exclusiveMinimum": 0
              }
            }
          }
        }
      ]
    },
    "resourceReference": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/resourceId"
        },
        "version": {
          "$ref": "#/$defs/version"
        }
      },
      "required": [
        "id",
        "version"
      ],
      "type": "object"
    },
    "version": {
      "minimum": 1,
      "type": "integer"
    },
    "pointMeters": {
      "items": false,
      "maxItems": 2,
      "minItems": 2,
      "prefixItems": [
        {
          "type": "number"
        },
        {
          "type": "number"
        }
      ],
      "type": "array"
    },
    "grid": {
      "additionalProperties": false,
      "properties": {
        "cell_size_m": {
          "const": 5.0
        },
        "cic_origin_cell": {
          "const": [
            0,
            0
          ]
        },
        "deck_height_m": {
          "const": 5.0
        },
        "forward_axis": {
          "const": "+Y"
        },
        "symmetry_axis": {
          "const": "Y"
        }
      },
      "required": [
        "cell_size_m",
        "deck_height_m",
        "forward_axis",
        "symmetry_axis",
        "cic_origin_cell"
      ],
      "type": "object"
    }
  },
  "$comment": "结构厚度上限、强制镜像和外飘几何/下层承接由解析器及编译器进一步校验。"
}
