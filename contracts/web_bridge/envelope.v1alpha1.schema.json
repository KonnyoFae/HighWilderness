{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gaotian.web-bridge/v1alpha1",
  "title": "高天荒野 Web 桥接信封 v1alpha1",
  "description": "W0 信封结构；UTF-8 分帧、重复键、深度、安全整数词法、握手参数与运行时调度约束另由参考合同校验。不是权威存档格式。",
  "oneOf": [
    {
      "$ref": "#/$defs/request"
    },
    {
      "$ref": "#/$defs/success"
    },
    {
      "$ref": "#/$defs/failure"
    },
    {
      "$ref": "#/$defs/event"
    }
  ],
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "not": {
        "pattern": "[\\r\\n]"
      }
    },
    "revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "name": {
      "type": "string",
      "pattern": "^(system|editor|resource|save|tactical|strategy)\\.[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)*$",
      "not": {
        "pattern": "[\\r\\n]"
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "details",
        "message",
        "path",
        "retryable",
        "source"
      ],
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "enum": [
            "host",
            "bridge",
            "domain"
          ]
        },
        "retryable": {
          "type": "boolean"
        },
        "details": {
          "type": "object"
        }
      }
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "backend_instance_id",
        "expected_revision",
        "interface",
        "kind",
        "method",
        "params",
        "request_id",
        "session_id"
      ],
      "properties": {
        "interface": {
          "const": "gaotian.web-bridge/v1alpha1"
        },
        "backend_instance_id": {
          "$ref": "#/$defs/id"
        },
        "session_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/id"
            },
            {
              "type": "null"
            }
          ]
        },
        "kind": {
          "const": "request"
        },
        "request_id": {
          "$ref": "#/$defs/requestId"
        },
        "expected_revision": {
          "anyOf": [
            {
              "$ref": "#/$defs/revision"
            },
            {
              "type": "null"
            }
          ]
        },
        "method": {
          "$ref": "#/$defs/name"
        },
        "params": {
          "type": "object"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "session_id": {
                "type": "null"
              }
            }
          },
          "then": {
            "properties": {
              "expected_revision": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "expected_revision": {
                "$ref": "#/$defs/revision"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "method": {
                "not": {
                  "pattern": "^(editor|save)\\."
                }
              }
            }
          },
          "then": {
            "properties": {
              "session_id": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "success": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "backend_instance_id",
        "error",
        "interface",
        "kind",
        "ok",
        "request_id",
        "result",
        "revision",
        "session_id"
      ],
      "properties": {
        "interface": {
          "const": "gaotian.web-bridge/v1alpha1"
        },
        "backend_instance_id": {
          "$ref": "#/$defs/id"
        },
        "session_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/id"
            },
            {
              "type": "null"
            }
          ]
        },
        "kind": {
          "const": "response"
        },
        "request_id": {
          "$ref": "#/$defs/requestId"
        },
        "revision": {
          "anyOf": [
            {
              "$ref": "#/$defs/revision"
            },
            {
              "type": "null"
            }
          ]
        },
        "ok": {
          "const": true
        },
        "result": {
          "type": "object"
        },
        "error": {
          "type": "null"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "session_id": {
                "type": "null"
              }
            }
          },
          "then": {
            "properties": {
              "revision": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "revision": {
                "$ref": "#/$defs/revision"
              }
            }
          }
        }
      ]
    },
    "failure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "backend_instance_id",
        "error",
        "interface",
        "kind",
        "ok",
        "request_id",
        "result",
        "revision",
        "session_id"
      ],
      "properties": {
        "interface": {
          "const": "gaotian.web-bridge/v1alpha1"
        },
        "backend_instance_id": {
          "$ref": "#/$defs/id"
        },
        "session_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/id"
            },
            {
              "type": "null"
            }
          ]
        },
        "kind": {
          "const": "response"
        },
        "request_id": {
          "$ref": "#/$defs/requestId"
        },
        "revision": {
          "anyOf": [
            {
              "$ref": "#/$defs/revision"
            },
            {
              "type": "null"
            }
          ]
        },
        "ok": {
          "const": false
        },
        "result": {
          "type": "null"
        },
        "error": {
          "$ref": "#/$defs/error"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "session_id": {
                "type": "null"
              }
            }
          },
          "then": {
            "properties": {
              "revision": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "backend_instance_id",
        "event",
        "interface",
        "kind",
        "payload",
        "revision",
        "sequence",
        "session_id"
      ],
      "properties": {
        "interface": {
          "const": "gaotian.web-bridge/v1alpha1"
        },
        "backend_instance_id": {
          "$ref": "#/$defs/id"
        },
        "session_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/id"
            },
            {
              "type": "null"
            }
          ]
        },
        "kind": {
          "const": "event"
        },
        "revision": {
          "anyOf": [
            {
              "$ref": "#/$defs/revision"
            },
            {
              "type": "null"
            }
          ]
        },
        "sequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "event": {
          "$ref": "#/$defs/name"
        },
        "payload": {
          "type": "object"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "session_id": {
                "type": "null"
              }
            }
          },
          "then": {
            "properties": {
              "revision": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "revision": {
                "$ref": "#/$defs/revision"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "event": {
                "not": {
                  "pattern": "^(editor|save)\\."
                }
              }
            }
          },
          "then": {
            "properties": {
              "session_id": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "requestId": {
      "type": "string",
      "pattern": "^req\\.[1-9][0-9]{0,14}$",
      "not": {
        "pattern": "[\\r\\n]"
      }
    }
  }
}
