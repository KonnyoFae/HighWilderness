* text=auto

.gitattributes text eol=lf
.gitignore text eol=lf
*.py text eol=lf
*.md text eol=lf
*.json text eol=lf

*.jpeg binary
*.jpg binary
*.png binary
*.docx binary

# Frozen experiment evidence is hashed byte-for-byte, including line endings.
artifacts/t3a-realtime-experiment/** -text !eol whitespace=cr-at-eol
artifacts/t3a-realtime-experiment/**/tracked-python.patch -diff -whitespace

# Fire-control fixture and measurement hashes also cover exact artifact bytes.
artifacts/tactical-fire-control-*/** -text !eol whitespace=cr-at-eol
artifacts/tactical-fire-control-*/**/*.txt whitespace=cr-at-eol,-blank-at-eof

# 7b evidence index records original bytes, including Windows line endings.
artifacts/tactical-7b-20261009/** -text !eol whitespace=cr-at-eol
artifacts/tactical-7b-20261009/**/*.txt whitespace=cr-at-eol,-blank-at-eol,-blank-at-eof

# 7c attribution provenance also records exact report bytes.
artifacts/tactical-7c-analysis-20261010/** -text !eol whitespace=cr-at-eol
artifacts/tactical-7c1a-20261010/** -text !eol whitespace=cr-at-eol
artifacts/tactical-7c1b-20261012/** -text !eol whitespace=cr-at-eol
artifacts/tactical-7c2-20261012/** -text !eol whitespace=cr-at-eol
artifacts/tactical-7c3-20261012/** -text !eol whitespace=cr-at-eol

# Frozen comparison source retains the exact bytes recorded in evidence hashes.
tools/tactical_7c1b_reference.py -text !eol whitespace=cr-at-eol,-blank-at-eof
tools/tactical_7c2_reference_aviation_*.py -text !eol whitespace=cr-at-eol,-blank-at-eof
tools/tactical_7c3_reference_*.py -text !eol whitespace=cr-at-eol
